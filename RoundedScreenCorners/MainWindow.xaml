<Window
    x:Class="RoundedScreenCorners.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Rounded Screen Corners">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,18,0,4" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,144,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="18" Height="18" VerticalAlignment="Center" Source="ms-appx:///Assets/AppIcon.ico" />
            <TextBlock Grid.Column="1" Text="Rounded Screen Corners" VerticalAlignment="Center" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsSettingsVisible="True"
            OpenPaneLength="210"
            PaneDisplayMode="Left"
            SelectionChanged="OnShellNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Corners" Tag="corners">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Displays" Tag="displays">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <ScrollViewer x:Name="HomePage" Padding="36,28" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="1000" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,26">
                                    <Image Width="96" Height="96" HorizontalAlignment="Center" Source="ms-appx:///Assets/Square150x150Logo.png" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <TextBlock Text="Rounded Screen Corners" Style="{StaticResource PageTitleStyle}" Margin="0" />
                                        <TextBlock x:Name="HomeVersionText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock
                                        MaxWidth="600"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="A polished utility that masks hard display corners with configurable circle or squircle overlays across your monitors."
                                        TextAlignment="Center" />
                                </StackPanel>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <tk:SettingsCard Header="Corners" Description="Radius, style, color, opacity" IsClickEnabled="True" Tag="corners" Click="OnDashboardCardClick">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE7FC;" />
                                        </tk:SettingsCard.HeaderIcon>
                                    </tk:SettingsCard>
                                    <tk:SettingsCard Grid.Column="1" Header="Displays" Description="All displays or a specific monitor" IsClickEnabled="True" Tag="displays" Click="OnDashboardCardClick">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE7F8;" />
                                        </tk:SettingsCard.HeaderIcon>
                                    </tk:SettingsCard>
                                    <tk:SettingsCard Grid.Row="1" Header="App settings" Description="Startup, tray, theme, reset" IsClickEnabled="True" Tag="settings" Click="OnDashboardCardClick">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xEC7A;" />
                                        </tk:SettingsCard.HeaderIcon>
                                    </tk:SettingsCard>
                                    <tk:SettingsCard Grid.Row="1" Grid.Column="1" Header="Live preview" Description="See changes before they hit the screen" IsClickEnabled="True" Tag="corners" Click="OnDashboardCardClick">
                                        <tk:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE8A1;" />
                                        </tk:SettingsCard.HeaderIcon>
                                    </tk:SettingsCard>
                                </Grid>

                                <TextBlock Text="Preview" Style="{StaticResource GroupHeaderStyle}" />
                                <Border
                                    Padding="22"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid
                                        x:Name="PreviewSurface"
                                        Width="360"
                                        Height="210"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Path x:Name="PreviewTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Stretch="Fill">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="180" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="PreviewTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Stretch="Fill">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="270" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="PreviewBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Stretch="Fill" />
                                        <Path x:Name="PreviewBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Stretch="Fill">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="CornersPage" Padding="36,28" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="1000" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Corners" Style="{StaticResource PageTitleStyle}" />
                                <tk:SettingsCard Header="Rounded corners" Description="Turn all overlay masks on or off.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE73E;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="EnabledToggle" AutomationProperties.Name="Enable rounded corners" Toggled="OnSettingChanged" />
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Radius" Description="Controls how deep the rounded corner cutout is." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A1;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <StackPanel Spacing="8">
                                        <Slider x:Name="RadiusSlider" AutomationProperties.Name="Corner radius" ValueChanged="OnRangeSettingChanged" />
                                        <TextBlock x:Name="RadiusLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Rounding style" Description="Choose a classic circular arc or a smoother squircle profile.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7FC;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="RoundingModeComboBox" MinWidth="180" SelectionChanged="OnSelectionSettingChanged">
                                        <ComboBoxItem Content="Circle" />
                                        <ComboBoxItem Content="Squircle" />
                                    </ComboBox>
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Mask color" Description="Black blends with most monitor bezels; white works for light display frames.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="MaskColorComboBox" MinWidth="180" SelectionChanged="OnSelectionSettingChanged">
                                        <ComboBoxItem Content="Black" />
                                        <ComboBoxItem Content="Dark gray" />
                                        <ComboBoxItem Content="White" />
                                    </ComboBox>
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Opacity" Description="Lower opacity is useful for screenshots or translucent overlays." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7A5;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <StackPanel Spacing="8">
                                        <Slider x:Name="OpacitySlider" AutomationProperties.Name="Mask opacity" ValueChanged="OnRangeSettingChanged" />
                                        <TextBlock x:Name="OpacityLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Edge padding" Description="Extends the mask along the edges for panels with visible gaps.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <NumberBox x:Name="EdgePaddingBox" MinWidth="160" SpinButtonPlacementMode="Inline" ValueChanged="OnNumberSettingChanged" />
                                </tk:SettingsCard>
                                <TextBlock Text="Active corners" Style="{StaticResource GroupHeaderStyle}" />
                                <tk:SettingsCard Header="Corner selection" Description="Disable any physical corner you do not want masked." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="TopLeftCheckBox" Content="Top left" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                        <CheckBox x:Name="TopRightCheckBox" Grid.Column="1" Content="Top right" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                        <CheckBox x:Name="BottomLeftCheckBox" Grid.Row="1" Content="Bottom left" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                        <CheckBox x:Name="BottomRightCheckBox" Grid.Row="1" Grid.Column="1" Content="Bottom right" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                                    </Grid>
                                </tk:SettingsCard>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="DisplaysPage" Padding="36,28" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="1000" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Displays" Style="{StaticResource PageTitleStyle}" />
                                <tk:SettingsCard Header="Apply to all displays" Description="Create an overlay for every connected monitor.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F8;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="AllDisplaysToggle" AutomationProperties.Name="Apply to all displays" Toggled="OnSettingChanged" />
                                </tk:SettingsCard>
                                <tk:SettingsCard x:Name="SpecificMonitorCard" Header="Specific display" Description="When all displays is off, use this monitor.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="SpecificMonitorComboBox" MinWidth="260" DisplayMemberPath="DisplayName" SelectionChanged="OnSelectionSettingChanged" />
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Connected displays" Description="Refresh after connecting, disconnecting, or rearranging monitors." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <StackPanel Spacing="10">
                                        <Button Click="OnRefreshDisplaysClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                <TextBlock Text="Refresh displays" />
                                            </StackPanel>
                                        </Button>
                                        <ListView x:Name="MonitorListView" SelectionMode="None" MaxHeight="260" />
                                    </StackPanel>
                                </tk:SettingsCard>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Padding="36,28" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="1000" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="App settings" Style="{StaticResource PageTitleStyle}" />
                                <tk:SettingsCard Header="Launch at startup" Description="Start Rounded Screen Corners automatically when you sign in.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7E8;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="StartupToggle" Toggled="OnStartupToggled" />
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Hide tray icon" Description="Run quietly. Open settings again from Start.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xED1A;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="HideTrayIconToggle" Toggled="OnHideTrayIconToggled" />
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Start minimized" Description="Keep the settings window hidden on startup task launch.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE921;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="StartMinimizedToggle" Toggled="OnSettingChanged" />
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="App theme" Description="Choose the settings window theme.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="ThemeComboBox" MinWidth="180" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="Use system theme" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </tk:SettingsCard>
                                <TextBlock Text="Application" Style="{StaticResource GroupHeaderStyle}" />
                                <tk:SettingsCard Header="Reset all settings" Description="Restore defaults and reapply overlays immediately.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <Button Click="OnResetAllClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                                            <TextBlock Text="Reset" />
                                        </StackPanel>
                                    </Button>
                                </tk:SettingsCard>
                                <tk:SettingsCard Header="Exit utility" Description="Remove overlays, save settings, and close the app.">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <Button Click="OnExitClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                            <TextBlock Text="Exit" />
                                        </StackPanel>
                                    </Button>
                                </tk:SettingsCard>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutPage" Padding="36,28" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="1000" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />
                                <tk:SettingsExpander Description="A modern WinUI 3 utility for configurable rounded screen corner overlays.">
                                    <tk:SettingsExpander.Header>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Rounded Screen Corners" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </tk:SettingsExpander.Header>
                                    <tk:SettingsExpander.HeaderIcon>
                                        <ImageIcon Source="ms-appx:///Assets/AppIcon.ico" Width="32" Height="32" />
                                    </tk:SettingsExpander.HeaderIcon>
                                    <tk:SettingsExpander.Items>
                                        <tk:SettingsCard
                                            Header="Microsoft Store"
                                            Description="Store ID 9N9XMSJZDTSC">
                                            <tk:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE7B8;" />
                                            </tk:SettingsCard.HeaderIcon>
                                            <HyperlinkButton NavigateUri="https://apps.microsoft.com/detail/9N9XMSJZDTSC">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                                                    <TextBlock Text="View store listing" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </tk:SettingsCard>
                                    </tk:SettingsExpander.Items>
                                </tk:SettingsExpander>
                                <InfoBar
                                    Margin="0,12,0,0"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="This app stores settings locally and does not need network access."
                                    Severity="Informational" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
